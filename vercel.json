{
  "cleanUrls": true,
  "redirects": [
    { "source": "/resume.html", "destination": "/Sahil-A-Gowda-Resume.pdf", "permanent": true },
    { "source": "/Sahil A Gowda Resume.pdf", "destination": "/Sahil-A-Gowda-Resume.pdf", "permanent": true },
    { "source": "/Sahil%20A%20Gowda%20Resume.pdf", "destination": "/Sahil-A-Gowda-Resume.pdf", "permanent": true }
  ],
  "rewrites": [{ "source": "/((?!assets/)[^.]*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
